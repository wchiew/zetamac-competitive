{
  "name": "zetamac-competitive",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "npm run dev --workspace @zmc/web",
    "dev:server": "npm run dev --workspace @zmc/server",
    "build": "npm run build --workspace @zmc/web",
    "start": "npm run build && npm run start --workspace @zmc/server",
    "tunnel": "node scripts/tunnel.mjs",
    "preview": "npm run preview --workspace @zmc/web",
    "check": "npm run check --workspace @zmc/web && npm run check --workspace @zmc/server",
    "test": "npm run test --workspace @zmc/shared"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.6.3"
  }
}
